{
  // Structural values are frozen after provisioning; comments are ignored.
  "format_version": 1,
  "naming_rules_version": 1,
  "database_name": "ouroboros",
  "schema": "ouroboros",
  // Singular vocabulary only; activity has no table or prefix.
  "vocabulary": {
    "work": {
      "name": "work"
    },
    "platform": {
      "name": "platform"
    },
    "tag": {
      "name": "tag"
    },
    "activity": {
      "name": "watch"
    }
  },
  "base_quantity_digits": 7,
