{
  "host": "localhost",
  "port": 6969,
  "browser": {
    "origin": "http://localhost:6969",
    "allow_loopback_http": true,
    "idle_timeout_seconds": 7200,
    "absolute_lifetime_seconds": 43200
  },
  "application_timezone": "Europe/Lisbon",
  "default_display_timezone": "Europe/Lisbon",
  "api": {
    "max_batch_size": 300,
    "max_creation_body_bytes": 4194304
  },
  "transcription": {
    "model": "base",
    "device": "cpu",
    "compute_type": "int8",
    "cache_directory": ".cache/speech",
    "local_files_only": false,
    "idiomas_transcricao": ["pt", "en", "es", "fr", "it"],
    "max_audio_bytes": 8388608,
    "max_duration_seconds": 60,
    "max_concurrency": 1,
    "cpu_threads": 2
  },
  "audit": {
    "request_body_max_bytes": 8192,
    "response_body_max_bytes": 8192,
    "mutation_max_bytes": 8192,
    "query_max_bytes": 8192
  },
  "database": {
    "name": "",
    "user": "",
    "port": 6669,
    "startup_timeout": 120,
    "connect_timeout": 10,
    "statement_timeout": 30,
    "max_connections": 8,
    "connection_acquire_timeout": 5
  },
  "logging": {
    "level": "DEBUG",
    "format": "%(level)-8s | %(interaction_id)-24s | %(datetime)s | %(category)-11s | %(method_path)s | %(component)s | %(class_name)s | %(source)s:%(line)s | %(message)s | %(context)s",
    "directory": "logs",
    "body_max_chars": 2048
  },
  "auth": {
    "token_ttl_seconds": 1800,
    "issuer": "ouroboros",
    "audience": "ouroboros-api"
  },
  "api_users": {
    "last_api_username": ""
  },
  "infrastructure": {
    "project_name": "ouroboros",
    "workspace": ""
  }
}
