# Optional CPU model-cache preparation image; no listener, database or new ports.
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /runtime
COPY requirements-transcription.txt ./
RUN pip install --no-cache-dir -r requirements-transcription.txt
COPY app/config.py app/transcription.py app/ai_config.py ./app/
COPY .ai.config.example ./
ENV HF_HUB_DISABLE_TELEMETRY=1
VOLUME ["/models"]
CMD ["python", "-c", "from app.transcription import LocalTranscription; LocalTranscription({'transcription': {'cache_directory': '/models'}}).model()"]
