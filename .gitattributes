# Migration integrity is defined by exact bytes, not checkout-specific newlines.
# Preserve each committed migration's original bytes on every platform.
modules/database/sql/migrations/*.sql -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# The new-installation registry hashes these baseline sources as exact bytes.
modules/database/model.py -text
modules/database/provision.py -text
modules/database/sql/api_migrations/*.sql -text
modules/database/sql/upgrades/*.sql -text
modules/frontend/*.sh text eol=lf
