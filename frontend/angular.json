{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {"analytics": false},
  "projects": {"ouroboros": {
    "projectType": "application", "root": "", "sourceRoot": "src",
    "architect": {
      "build": {"builder": "@angular/build:application", "options": {
        "outputPath": "dist", "deleteOutputPath": false, "browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.app.json",
        "assets": [{"glob": "**/*", "input": "assets", "output": "assets"}],
        "styles": ["styles/main.css", "styles/shared-fields.css"], "baseHref": "/", "deployUrl": "/frontend/", "inlineStyleLanguage": "css"
      }, "configurations": {
        "production": {"outputHashing": "all", "optimization": {"scripts": true, "styles": {"minify": true, "inlineCritical": false}, "fonts": false}, "budgets": [{"type": "initial", "maximumWarning": "350kB", "maximumError": "450kB"}, {"type": "anyComponentStyle", "maximumWarning": "4kB", "maximumError": "8kB"}]},
        "development": {"optimization": false, "sourceMap": true, "extractLicenses": false}
      }, "defaultConfiguration": "production"},
      "test": {"builder": "@angular/build:unit-test", "options": {"tsConfig": "tsconfig.spec.json", "runner": "vitest"}}
    }
  }}
}
