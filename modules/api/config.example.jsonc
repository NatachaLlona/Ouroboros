{
  // Database structure comes exclusively from provisioning.jsonc and its registry.
  "host": "127.0.0.1",
  "port": 6969,
  // PEM files are mounted read-only. Keep the key outside Git and build contexts.
  // Create and trust the local certificate as documented in docs/API.md.
  "tls": {
    "certificate_file": ".secrets/api-local.pem",
    "private_key_file": ".secrets/api-local-key.pem",
    "server_name": "localhost"
  },
  "startup_timeout_seconds": 120,
  "connect_timeout_seconds": 5,
  "statement_timeout_ms": 10000,
  "connection_acquire_timeout_seconds": 5,
  "max_connections": 8,
  "token": {
    "issuer": "ouroboros-api",
    "audience": "ouroboros-integrations",
    "clock_skew_seconds": 0
  },
  // Operator bounds are authoritative. Persisted installation adjustments must
  // remain inside these bounds, including their persisted minimum and maximum.
  "limits": {
    "request_bytes": {"minimum": 1024, "maximum": 1048576, "value": 1048576},
    "batch_items": {"minimum": 1, "maximum": 300, "value": 100},
    "page_size": {"minimum": 1, "maximum": 100, "value": 50},
    "token_ttl_seconds": {"minimum": 60, "maximum": 3600, "value": 900}
  }
}
